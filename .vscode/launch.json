{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    
    "configurations": [
        {
            "name": "Backend",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Api/bin/Debug/net10.0/MainApi.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "C# attach",
            "type": "coreclr",
            "request": "attach"
        },
         {
            "name": "Frontend",
            "type" : "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/GFlowApp/bin/Debug/net10.0/GFlowApp.dll",
            "cwd": "${workspaceFolder}/GFlowApp"
         }
    ],
    
    "compounds": [
        {
            "name": "Start Backend&Frontend",
            "configurations": ["Backend", "Frontend"]
        }
    ]
}