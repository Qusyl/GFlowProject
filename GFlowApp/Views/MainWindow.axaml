<Window xmlns="https://github.com/avaloniaui"
     
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GFlowApp.ViewModels"
        xmlns:props="using:GFlowApp.ViewModels.Properties"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:GFlowApp.Services"
        x:Name="Root"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="GFlowApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GFlowApp"
        Width="1920"
        Height="1080">
        <Window.Resources>
            <local:JsonToStringElementConverter x:Key="JsonToStringElementConverter"/>
            <local:IsZeroElementConverter x:Key="IsZeroElementConverter"/>
            <local:PortsClickedArgsConverter x:Key="PortsClickedArgsConverter"/>
    </Window.Resources>
    <Window.DataTemplates>
<DataTemplate DataType="{x:Type props:TextFieldPropertyViewModel}">
        <StackPanel Spacing="4">
            <TextBlock
                Text="{Binding Schema.Name}"
                FontWeight="SemiBold" />

            <TextBox Text="{Binding Value, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate>
     <DataTemplate DataType="{x:Type props:ArrayFieldPropertyViewModel}">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />

        <ItemsControl ItemsSource="{Binding Values}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</DataTemplate>
<DataTemplate DataType="{x:Type props:DictionaryFieldPropertyViewModel}">
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="8"
            Margin="0,4"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Schema.Name}" 
                           FontWeight="SemiBold" 
                           FontSize="13"
                           VerticalAlignment="Center" />
                
                <Button Content="➕ Добавить параметр"
                        Command="{Binding AddItemCommand}"
                        Margin="12,0,0,0"
                        Padding="12,4"
                        CornerRadius="4"
                        Background="#EE690B"
                        Foreground="White"
                        FontSize="12"
                        Cursor="Hand"
                        HorizontalAlignment="Right" />
            </StackPanel>
            
         
            <TextBlock Text="Нет параметров. Нажмите 'Добавить параметр' для создания."
                       Foreground="Gray"
                       FontStyle="Italic"
                       FontSize="12"
                       IsVisible="{Binding Values.Count, Converter={x:Static local:IsZeroElementConverter.Instance}}" />
            
          
            <ItemsControl ItemsSource="{Binding Values}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type props:DictionaryItemViewModel}">
                        <Border BorderBrush="#E0E0E0" 
                                BorderThickness="0,0,0,1" 
                                Padding="4,8"
                                Margin="0,2">
                            <Grid ColumnDefinitions="Auto, *, Auto" 
                                  HorizontalAlignment="Stretch"
                                  RowDefinitions="Auto, Auto">
                                
                           
                                <TextBox Grid.Column="0" 
                                         Grid.Row="0"
                                         Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Watermark="Ключ" />
                                
                             
                                <ContentControl Grid.Column="1" 
                                                Grid.Row="0"
                                                Content="{Binding Value}" 
                                                Margin="0,0,8,0"
                                                HorizontalAlignment="Stretch" />
                                
                              
                                <Button Grid.Column="2" 
                                        Grid.Row="0"
                                        Content="✕"
                                        Command="{Binding RemoveCommand}"
                                        Background="Transparent"
                                        Foreground="#CC0000"
                                        FontWeight="Bold"
                                        FontSize="16"
                                        Padding="4,0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" />
                                
                             
                                <TextBlock Grid.Column="0" 
                                           Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Text="Введите ключ и значение"
                                           Foreground="Gray"
                                           FontSize="10"
                                           FontStyle="Italic"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</DataTemplate>

 <DataTemplate DataType="{x:Type props:DictionaryItemViewModel}">
    <Grid ColumnDefinitions="Auto, *">
        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
        <ContentControl Grid.Column="1" Content="{Binding Value}" />
    </Grid>
</DataTemplate> 
 <DataTemplate DataType="{x:Type props:PolymorphicFieldPropertyViewModel}">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />

        <ComboBox ItemsSource="{Binding Variants}"
                  SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                  DisplayMemberBinding="{Binding Name}" />

        <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" Margin="0,4,0,0"
                IsVisible="{Binding SelectedVariant, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</DataTemplate> 
     <DataTemplate DataType="{x:Type props:ObjectFieldPropertyViewModel}">
        <Expander IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />
            </Expander.Header>

            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Margin="4,4,4,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
    </DataTemplate> 
<DataTemplate DataType="{x:Type props:ReferenceFieldPropertyViewModel}">
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="4" 
            Padding="8"
            Margin="0,4"
            HorizontalAlignment="Stretch">
        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
           
            <TextBlock Text="{Binding Schema.Name}" 
                       FontWeight="SemiBold" 
                       FontSize="13" 
                       Foreground="#333" />
            
            
            <ContentControl Content="{Binding Value}" 
                            Margin="4,4,4,4"
                            HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</DataTemplate>
     <DataTemplate DataType="{x:Type props:NumericFieldPropertyViewModel}">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />
            <NumericUpDown Value="{Binding Value, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate> 

    <DataTemplate DataType="{x:Type props:BooleanFieldPropertyViewModel}">
        <CheckBox Content="{Binding Schema.Name}" IsChecked="{Binding Value, Mode=TwoWay}" />
    </DataTemplate> 

    <DataTemplate DataType="{x:Type props:EnumFieldPropertyViewModel}">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedValue, Mode=TwoWay}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type props:AnyFieldPropertyViewModel}">
    <StackPanel Spacing="4">
        <TextBlock Text="{Binding Schema.Name}" FontWeight="SemiBold" />
        <TextBox Text="{Binding Value, Mode=TwoWay, Converter={StaticResource JsonToStringElementConverter}}"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 Height="60" />
    </StackPanel>
</DataTemplate> 
    </Window.DataTemplates>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
   
    <Grid ColumnDefinitions="300, *">
        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <ScrollViewer>
      
                <StackPanel Margin="10" Spacing="5">
                    
                    <!-- Блок ТРИГГЕРЫ -->
                    <Expander Header="Triggers" HorizontalAlignment="Stretch" IsExpanded="True">
        <ItemsControl ItemsSource="{Binding TriggerItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Model.NodeType}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddBlockCommand}"
                            CommandParameter="{Binding Model.NodeType}"
                            HorizontalAlignment="Stretch"
                            Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
                    <!-- Блок ЛОГИКА -->
                   <Expander Header="Logic" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding LogicItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Model.NodeType }"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddBlockCommand}"
                            CommandParameter="{Binding Model.NodeType}"
                            HorizontalAlignment="Stretch"
                            Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
                    <!-- Блок ДЕЙСТВИЯ -->
                    <Expander Header="Actions" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding ActionItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Model.NodeType}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddBlockCommand}"
                            CommandParameter="{Binding Model.NodeType}"
                            HorizontalAlignment="Stretch"
                            Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
    <Button Content="▶ Execute" 
        Command="{Binding ExecuteWorkflowCommand}"
        Background="#4CAF50"
        Foreground="White"
        Padding="20,10"
        CornerRadius="4"
        HorizontalAlignment="Right"
        Margin="10" />
                </StackPanel>
            </ScrollViewer>
        </Border>

    <Grid Grid.Column="1">

    <!-- ================================================= -->
    <!-- CONNECTIONS                                       -->
    <!-- ================================================= -->

    <ItemsControl
        ItemsSource="{Binding Connections}"
        IsHitTestVisible="False">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>

            <DataTemplate
                DataType="vm:ConnectionViewModel">

                <local:NodeConnection
                    StartPoint="{Binding StartPoint}"
                    EndPoint="{Binding EndPoint}"
                    Stroke="#EE690B"
                    StrokeThickness="4" />

            </DataTemplate>

        </ItemsControl.ItemTemplate>

    </ItemsControl>


    <!-- ================================================= -->
    <!-- BLOCKS                                            -->
    <!-- ================================================= -->

    <ItemsControl
        ItemsSource="{Binding Blocks}">

        <ItemsControl.ItemsPanel>

            <ItemsPanelTemplate>
                <Canvas />
            </ItemsPanelTemplate>

        </ItemsControl.ItemsPanel>

       

        <ItemsControl.Styles>

            <Style
                Selector="ContentPresenter"
                x:DataType="vm:BlockViewModel">

                <Setter
                    Property="Canvas.Left"
                    Value="{Binding X}" />

                <Setter
                    Property="Canvas.Top"
                    Value="{Binding Y}" />

            </Style>

        </ItemsControl.Styles>


        <ItemsControl.ItemTemplate>

            <DataTemplate
                DataType="vm:BlockViewModel">

                <Border
                    Background="{Binding Color}"
                    BorderBrush="#B0B0B0"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="10,6"
                    Width="150"
                    Height="150"
                    PointerPressed="Node_PointerPressed"
                    PointerReleased="Node_PointerReleased"
                    PointerMoved="Node_PointerMoved"
                    >
                  
                    <Grid>
                         <TextBlock 
        Text="{Binding #Root.DataContext.IsConnectionMode}"
        FontSize="20"
        >

        </TextBlock>

    <!-- Название -->
    <TextBlock
        Text="{Binding NodeType}"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        FontSize="15"/>

   <!-- INPUT PORTS -->
<ItemsControl
    ItemsSource="{Binding InputPorts}"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Button
                Width="20"
                Height="20"
                Background="#E30B0B"
                Content="I">
                <Button.Command>
                    <Binding Path="#Root.DataContext.PortClickedCommand" 
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=Window}"/>
                </Button.Command>
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource PortsClickedArgsConverter}">
                        <Binding Path="DataContext" 
                                 RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}"/>
                        <Binding />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>

<!-- OUTPUT PORTS -->
<ItemsControl
    ItemsSource="{Binding OutputPorts}"
    HorizontalAlignment="Right"
    VerticalAlignment="Center">
    <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Button
                Width="20"
                Height="20"
                Background="#EE690B"
                Content="O">
                <Button.Command>
                    <Binding Path="#Root.DataContext.PortClickedCommand" 
                             RelativeSource="{RelativeSource FindAncestor, AncestorType=Window}"/>
                </Button.Command>
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource PortsClickedArgsConverter}">
                        <Binding Path="DataContext" 
                                 RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}"/>
                        <Binding />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>

</Grid>
                    
                </Border>

            </DataTemplate>

        </ItemsControl.ItemTemplate>

    </ItemsControl>

</Grid>
        </Grid>
</Window>
